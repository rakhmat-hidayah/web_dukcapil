{
    "name": "Dukcapil Kabupaten Dompu",
    "short_name": "Dukcapil Dompu",
    "description": "Website Resmi Dinas Kependudukan dan Pencatatan Sipil Kabupaten Dompu, NTB",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "display_override": ["standalone", "minimal-ui", "window-controls-overlay"],
    "orientation": "portrait",
    "background_color": "#ffffff",
    "theme_color": "#0274cb",
    "icons": [
        {
            "src": "/favicon-16x16.png",
            "sizes": "16x16",
            "type": "image/png"
        },
        {
            "src": "/favicon-32x32.png",
            "sizes": "32x32",
            "type": "image/png"
        },
        {
            "src": "/apple-touch-icon.png",
            "sizes": "180x180",
            "type": "image/png"
        },
        {
            "src": "/img/logo-dompu-circle.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any maskable"
        }
    ]
}
