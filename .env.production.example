# =============================================================================
# PRODUCTION ENVIRONMENT — Disdukcapil Kabupaten Dompu
# Server: Plesk Obsidian | Linux | Apache+Nginx | PHP 8.3 | MariaDB
# =============================================================================
# PETUNJUK: Salin file ini menjadi .env pada server production
#           Ganti semua nilai [GANTI_INI] dengan nilai nyata
# =============================================================================

# --- Application ---
APP_NAME="Disdukcapil Kabupaten Dompu"
APP_ENV=production
APP_KEY=[GENERATE_DENGAN: php artisan key:generate --show]
APP_DEBUG=false
APP_URL=https://dukcapil.dompukab.go.id
APP_TIMEZONE=Asia/Makassar
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

# --- Database (MariaDB/MySQL via Plesk) ---
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=[NAMA_DATABASE_PLESK]
DB_USERNAME=[USER_DATABASE_PLESK]
DB_PASSWORD=[PASSWORD_DATABASE_PLESK_KUAT]
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# --- Cache (gunakan 'file' untuk Plesk shared hosting) ---
CACHE_STORE=file
CACHE_PREFIX=dukcapil_

# --- Session (database lebih aman untuk multi-process Plesk) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=dukcapil.dompukab.go.id

# --- Queue (sync untuk Plesk tanpa worker daemon) ---
QUEUE_CONNECTION=sync

# --- Filesystem ---
FILESYSTEM_DISK=local

# --- Logging ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error
LOG_DEPRECATIONS_CHANNEL=null

# --- Mail (SMTP belum tersedia — gunakan 'log' sebagai fallback aman) ---
# Jika SMTP sudah tersedia, ganti MAIL_MAILER=smtp dan isi konfigurasi di bawah
MAIL_MAILER=log
MAIL_LOG_CHANNEL=mail
#MAIL_HOST=smtp.example.com
#MAIL_PORT=587
#MAIL_USERNAME=
#MAIL_PASSWORD=
#MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@dukcapil.dompukab.go.id"
MAIL_FROM_NAME="Disdukcapil Kabupaten Dompu"

# --- Broadcasting ---
BROADCAST_CONNECTION=log

# --- Sanctum (API) ---
SANCTUM_STATEFUL_DOMAINS=dukcapil.dompukab.go.id

# --- Vite (production) ---
VITE_APP_NAME="${APP_NAME}"

# --- Security (tambahan untuk production) ---
FORCE_HTTPS=true

# =============================================================================
# SETELAH MENGISI .env, JALANKAN:
#   php artisan key:generate           (hanya jika fresh install)
#   php artisan migrate --force
#   php artisan db:seed --force        (hanya jika fresh install)
#   php artisan storage:link
#   php artisan optimize
# =============================================================================
